# Production-like run of the built app. Copy to .env.prod (git-ignored).
# Add every new variable to all .env.*.example files.

# Path of the logbuch SQLite database. Leave unset: the packaged app uses the path from its
# settings, default ~/.logbuch/logbuch.db. Set it only to point a build at another database.
# LOGBUCH_DB=

# userData folder of the app. Leave unset: the packaged app uses Electron's default.
# TRICORDER_USER_DATA=
