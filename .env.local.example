# Local development. Copy to .env.local (git-ignored); direnv loads it via .envrc.
# Add every new variable to all .env.*.example files.

# Path of the logbuch SQLite database. Overrides the path from the app settings.
# Unset: the app settings decide, default ~/.logbuch/logbuch.db (the real log that the CLI and
# the Claude Code hooks write). To develop against a scratch database instead, set an absolute
# path, e.g. LOGBUCH_DB=/tmp/logbuch-dev.db. The bin/logbuch CLI reads the same variable.
# LOGBUCH_DB=

# userData folder of the app (settings.json, secrets.json, logs/). Unset: `pnpm dev` uses
# "<appData>/Tricorder Dev", the packaged app Electron's default. Same as --user-data-dir=<dir>.
# TRICORDER_USER_DATA=
