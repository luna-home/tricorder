// Tests of the web context (jsdom).
{
  "extends": "./tsconfig.web.json",
  "include": [
    "src/renderer/env.d.ts",
    "src/renderer/**/*.spec.ts",
    "src/renderer/**/*.test.ts",
    "src/services/*/ui/**/*.spec.ts",
    "src/services/*/ui/**/*.test.ts"
  ],
  "exclude": [],
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "jsdom"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.web.test.tsbuildinfo"
  }
}
