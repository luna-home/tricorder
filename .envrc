# Node from .nvmrc (nvm is a shell function, so source it first).
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  source "$NVM_DIR/nvm.sh"
  nvm use --silent || log_error "Node $(cat .nvmrc) is not installed: run 'nvm install'"
else
  log_error "nvm not found: install Node $(cat .nvmrc) yourself"
fi
watch_file .nvmrc

# Environment: local (default), test, or prod.
export LUNA_ENV="${LUNA_ENV:-local}"
watch_file ".env.$LUNA_ENV"
if [ -f ".env.$LUNA_ENV" ]; then
  dotenv ".env.$LUNA_ENV"
else
  log_error ".env.$LUNA_ENV is missing: cp .env.$LUNA_ENV.example .env.$LUNA_ENV"
fi
