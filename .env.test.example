# Tests. Copy to .env.test (git-ignored) and run e.g. `LUNA_ENV=test direnv exec . pnpm test:e2e`.
# Add every new variable to all .env.*.example files.

# Path of the logbuch SQLite database. Tests must never touch the real ~/.logbuch/logbuch.db.
# Vitest and Playwright tests create their own temp databases; this value is the fallback for
# anything started by hand in the test environment. Use an absolute path.
LOGBUCH_DB=/tmp/tricorder-test/logbuch.db

# userData folder of the app. Playwright passes its own temp folder (--user-data-dir); this is
# the fallback for anything started by hand in the test environment. Use an absolute path.
TRICORDER_USER_DATA=/tmp/tricorder-test/userData
