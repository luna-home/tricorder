{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "vue", "vitest"],
  "env": {
    "browser": true,
    "node": true
  },
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "out/**",
    "release/**",
    "coverage/**",
    "test-results/**",
    "playwright-report/**",
    "src/renderer/design/luna-console/**",
    "bin/**",
    "hooks/**",
    "tests/**"
  ]
}
